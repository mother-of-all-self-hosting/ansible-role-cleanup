# Removes stopped containers, unused images and unused anonymous volumes.
#
# Generated by Ansible. Ansible runs it, and so can you.

import subprocess
import sys


class CleanupError(Exception):
    pass


def log(message):
    print(message, flush=True)


def docker(*args):
    try:
        result = subprocess.run(
            ["docker"] + list(args),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
        )
    except OSError as error:
        raise CleanupError("Cannot run `docker`: %s" % error)
    if result.returncode != 0:
        raise CleanupError(
            "`docker %s` failed with exit code %d: %s"
            % (" ".join(args), result.returncode, result.stderr.strip())
        )
    return result.stdout


def parse_prune_output(output, heading):
    """Extracts the lines listed under `heading` in the output of `docker ... prune`."""
    lines = []
    in_section = False
    for line in output.splitlines():
        line = line.strip()
        if line == heading:
            in_section = True
        elif line == "" or line.endswith(":") or line.startswith("Total reclaimed space"):
            in_section = False
        elif in_section:
            lines.append(line)
    return lines


def prune_containers():
    removed = parse_prune_output(docker("container", "prune", "-f"), "Deleted Containers:")
    for container_id in removed:
        log("Removed stopped container %s" % container_id[:12])
    return len(removed)


def prune_images():
    # `-a` removes every image no container uses, not just dangling ones.
    lines = parse_prune_output(docker("image", "prune", "-a", "-f"), "Deleted Images:")
    untagged = [line.split(": ", 1)[1] for line in lines if line.startswith("untagged: ")]
    deleted = [line for line in lines if line.startswith("deleted: ")]
    for reference in untagged:
        log("Removed image %s" % reference)
    if deleted:
        log("Removed %d image object(s) (images and their layers)" % len(deleted))
    return len(untagged)


def prune_volumes():
    # Without `--all`, this only removes anonymous volumes.
    removed = parse_prune_output(docker("volume", "prune", "-f"), "Deleted Volumes:")
    for volume in removed:
        log("Removed anonymous volume %s" % volume)
    return len(removed)


def main():
    try:
        containers = prune_containers()
        images = prune_images()
        volumes = prune_volumes()
    except CleanupError as error:
        print("Error: %s" % error, file=sys.stderr, flush=True)
        return 1

    log(
        "Summary: removed %d stopped container(s), %d image reference(s) and %d anonymous volume(s)"
        % (containers, images, volumes)
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
